<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ 제목 }} · {{ 날짜표시 }}</title>
<style>
  :root{
    --bg:#0e1116; --surface:#161b22; --surface2:#1c2230; --line:#242c3a;
    --ink:#e8edf5; --ink2:#a6b2c4; --ink3:#6f7d92;
    --up:#f05a5a; --down:#3b8fe8; --warn:#e0a33c; --accent:#7c6cf0;
    --p1:#e0524f; --p2:#e08a3c; --p3:#d9b93c;
  }
  @media (prefers-color-scheme: light){
    :root{ --bg:#f6f7f9; --surface:#ffffff; --surface2:#f0f2f6; --line:#e2e6ee;
           --ink:#161b22; --ink2:#4c5768; --ink3:#8792a4; }
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);
       font-family:-apple-system,BlinkMacSystemFont,"Apple SD Gothic Neo","Pretendard","Malgun Gothic",sans-serif;
       line-height:1.65;-webkit-font-smoothing:antialiased}
  .wrap{max-width:760px;margin:0 auto;padding:30px 20px 60px}
  header{border-bottom:1px solid var(--line);padding-bottom:16px;margin-bottom:24px}
  .eyebrow{font-size:11.5px;letter-spacing:.14em;color:var(--ink3);text-transform:uppercase;font-weight:600}
  h1{font-size:24px;margin:7px 0 5px;letter-spacing:-.02em;font-weight:700}
  .sub{color:var(--ink3);font-size:13px;margin:0}
  .sharebar{margin-top:14px}
  .kakao-share{appearance:none;border:0;border-radius:8px;background:#FEE500;color:#191919;
               padding:10px 15px;font:700 13px/1.2 inherit;cursor:pointer;display:inline-flex;
               align-items:center;gap:7px;box-shadow:0 1px 0 rgba(0,0,0,.08)}
  .kakao-share:hover{filter:brightness(.97)}
  .kakao-share:focus-visible{outline:3px solid rgba(254,229,0,.35);outline-offset:2px}
  h2{font-size:15px;margin:34px 0 12px;padding-bottom:8px;border-bottom:1px solid var(--line);
     letter-spacing:-.01em;display:flex;align-items:center;gap:7px;font-weight:700}
  h2 .tag{font-size:11px;font-weight:600;color:var(--ink3);letter-spacing:.04em;margin-left:auto}

  /* ── 툴팁 (호버 + 탭 모두 동작) ───────────────── */
  .tip{display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;
       border:1px solid var(--line);border-radius:50%;font-size:10px;color:var(--ink3);
       cursor:help;position:relative;font-weight:600;vertical-align:2px;margin-left:5px;
       background:var(--surface2);flex-shrink:0}
  .tip:hover,.tip:focus{color:var(--accent);border-color:var(--accent);outline:none}
  .tip .bubble{visibility:hidden;opacity:0;position:absolute;top:22px;left:50%;
       transform:translateX(-50%);width:min(340px,78vw);background:var(--surface2);
       border:1px solid var(--line);border-radius:8px;padding:10px 12px;z-index:20;
       font-size:12px;font-weight:400;color:var(--ink2);line-height:1.6;text-align:left;
       box-shadow:0 8px 24px rgba(0,0,0,.35);transition:opacity .12s}
  .tip:hover .bubble,.tip:focus .bubble{visibility:visible;opacity:1}
  .tip .bubble b{color:var(--ink)}
  .glossary{position:relative;border-bottom:1px dotted var(--accent);cursor:help;white-space:nowrap}
  .glossary-icon{font-size:10px;color:var(--accent);margin-left:2px}
  .glossary-bubble{visibility:hidden;opacity:0;position:absolute;left:0;top:1.7em;width:min(300px,76vw);
       white-space:normal;background:var(--surface2);border:1px solid var(--line);border-radius:8px;
       padding:9px 11px;z-index:30;font-size:11.5px;font-weight:400;color:var(--ink2);line-height:1.55;
       box-shadow:0 8px 24px rgba(0,0,0,.35)}
  .glossary:hover .glossary-bubble,.glossary:focus .glossary-bubble{visibility:visible;opacity:1;outline:none}
  @media (max-width:520px){ .tip .bubble{left:auto;right:-8px;transform:none} }

  /* ── TOP 5 ──────────────────────────────────── */
  .top5{display:flex;flex-direction:column;gap:6px;margin:4px 0}
  .rank{display:grid;grid-template-columns:auto 1fr;gap:11px;background:var(--surface);
        border:1px solid var(--line);border-radius:9px;padding:11px 14px;align-items:start}
  .rank .no{display:flex;align-items:center;justify-content:center;width:22px;height:22px;
            border-radius:50%;font-size:11.5px;font-weight:700;color:#fff;flex-shrink:0;margin-top:2px}
  .rank.r1 .no,.rank.r2 .no{background:var(--p1)}
  .rank.r3 .no,.rank.r4 .no{background:var(--p2)}
  .rank.r5 .no{background:var(--p3)}
  .rank .t{font-size:14px;font-weight:700;letter-spacing:-.01em;margin:0 0 2px}
  .rank .n{font-size:12.5px;color:var(--ink2);margin:0;font-variant-numeric:tabular-nums}
  .rank .n .arrow{color:var(--ink3);margin:0 5px}
  .rank .n .eff{color:var(--accent);font-weight:600}
  .rank .desc{font-size:12.5px;color:var(--ink2);margin:6px 0 0;line-height:1.55}
  .rank .src{margin-top:5px}
  .rank-more,.evidence{margin-top:7px;border-top:1px solid var(--line)}
  .rank-more summary,.evidence summary{cursor:pointer;color:var(--ink3);font-size:11.5px;
        padding:7px 0 1px;list-style:none;display:inline-flex;align-items:center;gap:5px}
  .rank-more summary::before,.evidence summary::before{content:"＋";font-weight:700;color:var(--accent)}
  .rank-more[open] summary::before,.evidence[open] summary::before{content:"－"}

  /* ── 시장 한눈에 ─────────────────────────────── */
  .glance{background:var(--surface);border:1px solid var(--line);border-radius:10px;
          padding:4px 16px;margin:12px 0}
  .grow{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
        gap:2px 22px;padding:11px 0;border-bottom:1px solid var(--line)}
  .grow:last-child{border-bottom:none}
  .gcell{display:flex;align-items:baseline;justify-content:space-between;gap:6px;padding:3px 0;min-width:0}
  .gcell .k{font-size:12px;color:var(--ink3);white-space:nowrap;flex-shrink:0}
  .gcell .v{font-size:13px;font-weight:700;font-variant-numeric:tabular-nums;
            text-align:right;white-space:nowrap}
  .gcell .v .p{font-size:11.5px;font-weight:600;margin-left:5px}
  @media (max-width:430px){ .grow{grid-template-columns:1fr;gap:0} }
  .up{color:var(--up)} .down{color:var(--down)} .flat{color:var(--ink3)}
  .glabel{font-size:10.5px;font-weight:700;color:var(--ink3);letter-spacing:.08em;
          padding:11px 0 2px;grid-column:1/-1}
  .period{width:100%;border-collapse:collapse;background:var(--surface);border:1px solid var(--line);
          border-radius:10px;overflow:hidden;font-size:12.5px;margin:10px 0}
  .period th,.period td{padding:9px 10px;border-bottom:1px solid var(--line);text-align:right}
  .period th:first-child,.period td:first-child{text-align:left}.period tr:last-child td{border-bottom:0}
  .regime{background:linear-gradient(135deg,rgba(124,108,240,.10),var(--surface));
          border:1px solid rgba(124,108,240,.35);border-radius:10px;padding:14px 16px;margin:12px 0}
  .regime h3{margin:0 0 6px;font-size:15px}.regime p{margin:0;color:var(--ink2);font-size:13px}
  .waitbox{background:var(--surface);border:1px solid var(--line);border-radius:10px;
           padding:3px 16px;margin:12px 0}
  .waitbox h3{font-size:15px;margin:12px 0 3px}.waititem{padding:10px 0;border-bottom:1px solid var(--line)}
  .waititem:last-child{border-bottom:none}.waititem .wt{display:flex;gap:9px;align-items:baseline}
  .waititem .wn{font-size:10px;font-weight:700;color:var(--accent);min-width:20px}
  .waititem b{font-size:13.5px}.waititem p{margin:5px 0 0 29px;color:var(--ink2);font-size:12.5px}
  .waititem .path{border-left:3px solid var(--accent);background:var(--surface2);padding:7px 9px;margin-top:7px}
  .waititem .src{margin-left:29px}
  .waititem .evidence{margin-left:29px}

  /* ── 시장 스토리 ─────────────────────────── */
  .story{background:var(--surface);border:1px solid var(--line);border-radius:10px;
         padding:15px 17px;margin:9px 0}
  .storyhead{display:flex;align-items:baseline;gap:9px;margin-bottom:9px}
  .marketbadge{font-size:10px;font-weight:700;color:var(--accent);border:1px solid rgba(124,108,240,.4);
               border-radius:4px;padding:1px 7px;flex-shrink:0}
  .story h3{font-size:15px;margin:0;line-height:1.45}
  .story-copy{font-size:13.5px;color:var(--ink2);line-height:1.75;margin:8px 0}
  .story-flow{font-size:12.5px;color:var(--ink);font-weight:600;background:rgba(124,108,240,.07);border-radius:7px;padding:8px 10px;margin:10px 0}
  .story-takeaway{background:var(--surface2);border-left:3px solid var(--accent);border-radius:0 7px 7px 0;padding:10px 12px;margin-top:11px;font-size:13px;color:var(--ink2)}
  .storyline{display:grid;grid-template-columns:54px 1fr;gap:7px 10px;margin:6px 0;font-size:13px}
  .storyline .k{color:var(--ink3);font-size:10.5px;font-weight:700;letter-spacing:.04em;padding-top:2px}
  .storyline .v{color:var(--ink2)}
  .storyline.interpretation{background:var(--surface2);border-left:3px solid var(--accent);
                            border-radius:0 7px 7px 0;padding:9px 11px;margin:8px 0}
  .storyline.interpretation .k{color:var(--accent)}
  .storyline.path{background:rgba(124,108,240,.07);border-radius:7px;padding:7px 9px}
  .storyline.path .v{color:var(--ink);font-weight:600}
  .storyline.meaning{background:var(--surface2);border-left:3px solid var(--accent);
                     border-radius:0 7px 7px 0;padding:9px 11px;margin-top:10px}
  .watch{background:linear-gradient(135deg,rgba(124,108,240,.10),var(--surface));
         border:1px solid rgba(124,108,240,.3);border-radius:9px;padding:11px 15px;margin:10px 0}
  .watch b{font-size:11px;color:var(--accent);letter-spacing:.05em}
  .watch ol{margin:5px 0 0;padding-left:20px;color:var(--ink2);font-size:12.5px}

  /* ── 카드 (사실/해석) ────────────────────────── */
  .card{background:var(--surface);border:1px solid var(--line);border-radius:10px;
        padding:14px 16px;margin:10px 0}
  .card h3{margin:0 0 8px;font-size:14.5px;font-weight:700;letter-spacing:-.01em}
  .fact{font-size:13.5px;color:var(--ink2);margin:0}
  .fact .k{display:inline-block;font-size:9.5px;font-weight:700;color:var(--ink3);
           border:1px solid var(--line);border-radius:4px;padding:1px 6px;margin-right:7px;
           letter-spacing:.08em;vertical-align:2px}
  .src{margin-top:7px;font-size:11.5px;color:var(--ink3)}
  .src a{color:var(--ink3);text-decoration:none;border-bottom:1px dotted var(--ink3)}
  .src a:hover{color:var(--accent);border-color:var(--accent)}
  .sdate{display:inline-block;margin-left:5px;font-size:10.5px;color:var(--ink3);
         border:1px solid var(--line);border-radius:4px;padding:0 5px;
         font-variant-numeric:tabular-nums;vertical-align:1px}
  .interp{margin-top:10px;background:var(--surface2);border:1px solid var(--line);
          border-left:3px solid var(--accent);border-radius:0 8px 8px 0;padding:10px 13px;
          font-size:12.5px;color:var(--ink2)}
  .interp .k{display:block;font-size:9.5px;font-weight:700;color:var(--accent);
             letter-spacing:.08em;margin-bottom:4px}

  /* ── 종목 (최대 3, 컴팩트) ──────────────────── */
  .stocks{display:flex;flex-direction:column;gap:6px;margin:10px 0}
  .srow{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:baseline;
        background:var(--surface2);border:1px solid var(--line);border-radius:8px;padding:9px 12px}
  .srow .nm{font-size:13px;font-weight:700}
  .srow .nm span{font-size:11px;color:var(--ink3);font-weight:400;margin-left:6px}
  .srow .pc{font-size:13px;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap}
  .srow .rz{grid-column:1/-1;font-size:12px;color:var(--ink3);margin-top:2px}

  /* ── ETF 레이더 ─────────────────────────────── */
  .radar{background:var(--surface);border:1px solid var(--line);border-radius:10px;
         padding:2px 16px;margin:10px 0}
  .ritem{padding:12px 0;border-bottom:1px solid var(--line)}
  .ritem:last-child{border-bottom:none}
  .ritem .h{display:flex;align-items:baseline;gap:8px;margin-bottom:4px;flex-wrap:wrap}
  .ritem .badge{font-size:10px;font-weight:700;letter-spacing:.04em;color:var(--accent);
                border:1px solid rgba(124,108,240,.4);border-radius:4px;padding:1px 6px;flex-shrink:0}
  .ritem .t{font-size:13.5px;font-weight:700;letter-spacing:-.01em}
  .flowboard{background:var(--surface);border:1px solid var(--line);border-radius:10px;
             padding:12px 14px;margin:10px 0}
  .flowtab-input{position:absolute;opacity:0;pointer-events:none}
  .flowtabs{display:flex;gap:6px;margin:0 0 11px}
  .flowtabs label{cursor:pointer;border:1px solid var(--line);border-radius:16px;padding:4px 14px;
                  color:var(--ink3);font-size:11.5px;font-weight:700;transition:.15s}
  #flow-kr:checked~.flowtabs label[for="flow-kr"],#flow-us:checked~.flowtabs label[for="flow-us"]{
                  background:var(--accent);border-color:var(--accent);color:#fff}
  .flow-panel{display:none}
  #flow-kr:checked~.flow-panels .flow-panel.kr,#flow-us:checked~.flow-panels .flow-panel.us{display:block}
  .flow-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:9px}
  .flow-head b{font-size:13.5px}.flow-head span{font-size:10.5px;color:var(--ink3)}
  .flow-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
  .flow-col{background:var(--surface2);border-radius:8px;padding:9px 10px}
  .flow-col h3{font-size:10.5px;color:var(--ink3);margin:0 0 5px;letter-spacing:.04em}
  .flow-row{display:flex;justify-content:space-between;gap:8px;padding:3px 0;font-size:12px}
  .flow-row .nm{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .flow-row .pct{font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums}
  .flow-extra{border-top:1px solid var(--line);margin-top:10px;padding-top:8px;font-size:11.5px;color:var(--ink2)}
  .flow-extra b{color:var(--ink3);font-size:10.5px;margin-right:6px}
  .flow-extra span+span:before{content:" · ";color:var(--ink3)}
  .flow-empty{color:var(--ink3);font-size:11.5px;margin:4px 0 0}
  @media(max-width:520px){.flow-grid{grid-template-columns:1fr}}
  .themebox{background:linear-gradient(135deg,rgba(224,163,60,.12),var(--surface));
            border:1px solid rgba(224,163,60,.38);border-radius:10px;padding:14px 16px;margin:10px 0}
  .themehead{display:flex;align-items:baseline;gap:9px;margin-bottom:8px}
  .themehead .badge{font-size:10px;font-weight:700;color:var(--warn);border:1px solid rgba(224,163,60,.45);
                    border-radius:4px;padding:1px 7px}.themehead h3{font-size:14.5px;margin:0}
  .themerow{display:grid;grid-template-columns:58px 1fr;gap:8px;font-size:12.5px;margin:6px 0}
  .themerow .k{color:var(--ink3);font-size:10.5px;font-weight:700}.themerow .v{color:var(--ink2)}
  .leaders{display:flex;flex-wrap:wrap;gap:6px;margin:9px 0 2px}
  .leader{background:var(--surface2);border:1px solid var(--line);border-radius:16px;
          padding:4px 9px;font-size:11.5px}.leader b{margin-left:5px;font-variant-numeric:tabular-nums}
  .stockwatch{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:3px 15px;margin:10px 0}
  .worldissues{display:flex;flex-direction:column;gap:8px}
  .worlditem{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:13px 15px}
  .worldhead{display:flex;align-items:baseline;gap:8px}.worldhead h3{font-size:14px;margin:0}
  .worldbadge{font-size:10px;font-weight:700;color:var(--accent);border:1px solid rgba(124,108,240,.4);
              border-radius:4px;padding:1px 6px;white-space:nowrap}
  .worlditem p{font-size:12.5px;color:var(--ink2);margin:7px 0 0}
  .worldpath{border-left:3px solid var(--accent);background:var(--surface2);padding:8px 10px;border-radius:0 7px 7px 0}
  .worldcheck{font-size:11.5px;color:var(--ink3);margin-top:7px}
  .stockwatch .sitem{padding:10px 0;border-bottom:1px solid var(--line)}
  .stockwatch .sitem:last-child{border-bottom:0}.stockwatch .st{display:flex;gap:8px;align-items:baseline}
  .stockwatch .st b{font-size:13px}.stockwatch .st span{font-size:11.5px;font-weight:700}
  .stockwatch p{margin:4px 0 0;color:var(--ink2);font-size:12.5px}
  .more-news{background:var(--surface);border:1px solid var(--line);border-radius:10px;
             padding:0 14px;margin:8px 0 12px}
  .more-news summary{cursor:pointer;padding:11px 0;font-size:12.5px;font-weight:700;color:var(--ink2)}
  .more-item{display:flex;align-items:center;gap:8px;padding:9px 0;border-top:1px solid var(--line);
             font-size:12.5px;flex-wrap:wrap}
  .more-item .badge{font-size:9.5px;color:var(--accent);border:1px solid rgba(124,108,240,.4);
                    border-radius:4px;padding:1px 5px}
  .more-item a{color:var(--ink);text-decoration:none;font-weight:650}
  .more-item small{margin-left:auto;color:var(--ink3)}
  .ritem p{margin:0;font-size:12.5px;color:var(--ink2)}
  .ritem .sig{margin-top:5px;font-size:12px;color:var(--ink3)}

  /* ── ETF 뉴스 6선 ───────────────────────────── */
  .newslist{background:var(--surface);border:1px solid var(--line);border-radius:10px;
            padding:2px 16px;margin:10px 0}
  .nitem{display:grid;grid-template-columns:auto 1fr;gap:11px;padding:11px 0;
         border-bottom:1px solid var(--line);align-items:start}
  .nitem:last-child{border-bottom:none}
  .nno{display:flex;align-items:center;justify-content:center;width:20px;height:20px;
       border-radius:5px;background:var(--surface2);border:1px solid var(--line);
       font-size:11px;font-weight:700;color:var(--ink3);flex-shrink:0;margin-top:1px}
  .nitem a{color:var(--ink);text-decoration:none;font-weight:700;font-size:13.5px;line-height:1.45}
  .nitem a:hover{color:var(--accent)}
  .nmeta{font-size:11.5px;color:var(--ink3);margin-top:3px}
  .nsum{font-size:12.5px;color:var(--ink2);margin-top:4px}
  .copybox{margin:8px 0 0}
  .copybox summary{font-size:12.5px;color:var(--ink3);cursor:pointer;padding:6px 2px;
                   list-style:none;display:inline-flex;align-items:center;gap:5px}
  .copybox summary::before{content:"📋"}
  .copybox summary:hover{color:var(--accent)}
  .copybox textarea{width:100%;margin-top:6px;background:var(--surface2);color:var(--ink2);
                    border:1px solid var(--line);border-radius:8px;padding:11px 13px;
                    font-size:12px;line-height:1.7;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
                    resize:vertical}

  .notice{background:var(--surface2);border:1px dashed var(--line);border-radius:9px;
          padding:12px 14px;margin:10px 0;font-size:12.5px;color:var(--ink3)}
  /* ── 유튜브 ─────────────────────────────────── */
  .yt{display:flex;flex-direction:column;gap:8px;margin:10px 0}
  .ytc{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:12px 15px}
  .ytc .top{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin-bottom:3px}
  .ytc a{color:var(--ink);text-decoration:none;font-weight:700;font-size:13.5px;line-height:1.45}
  .ytc a:hover{color:var(--accent)}
  .ytc .meta{font-size:11.5px;color:var(--ink3);margin-top:4px;font-variant-numeric:tabular-nums}
  .ytc .row{display:grid;grid-template-columns:58px 1fr;gap:4px 10px;margin-top:8px;font-size:12px}
  .ytc .row .k{color:var(--ink3);font-weight:600}
  .ytc .row .v{color:var(--ink2)}
  .ov{display:inline-block;font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:20px;white-space:nowrap}
  .ov.high{background:rgba(240,90,90,.15);color:var(--up);border:1px solid rgba(240,90,90,.35)}
  .ov.mid{background:rgba(224,163,60,.15);color:var(--warn);border:1px solid rgba(224,163,60,.35)}
  .ov.low{background:var(--surface2);color:var(--ink3);border:1px solid var(--line)}

  /* ── 콘텐츠 후보 ────────────────────────────── */
  .idea{background:linear-gradient(135deg,rgba(124,108,240,.10),rgba(124,108,240,.03));
        border:1px solid rgba(124,108,240,.32);border-radius:10px;padding:14px 16px;margin:10px 0}
  .idea .k{font-size:10.5px;font-weight:700;color:var(--accent);letter-spacing:.06em}
  .idea h3{margin:5px 0 8px;font-size:14.5px;font-weight:700;line-height:1.45}
  .idea .row{display:grid;grid-template-columns:74px 1fr;gap:5px 10px;font-size:12.5px}
  .idea .row .k2{color:var(--ink3);font-weight:600}
  .idea .row .v{color:var(--ink2)}
  .idea .q{margin-top:9px;padding:9px 11px;background:var(--surface);border-radius:7px;
           font-size:12.5px;color:var(--ink2);border-left:2px solid var(--accent)}

  /* ── 일정 ───────────────────────────────────── */
  .cal{display:grid;grid-template-columns:auto 1fr;gap:9px 14px;font-size:13px;margin:10px 0}
  .cal .d{color:var(--ink3);font-weight:600;white-space:nowrap;font-variant-numeric:tabular-nums}
  .cal .e{color:var(--ink2)}
  .calgroup{grid-column:1/-1;font-size:11px;font-weight:700;color:var(--ink3);
            letter-spacing:.06em;border-bottom:1px solid var(--line);padding:7px 0 4px;margin-top:4px}
  .cal .e small{display:block;margin-top:2px;font-size:10.5px}.cal .e small a{color:var(--ink3)}
  .cpk{display:inline-block;font-size:10px;font-weight:700;border-radius:4px;
       padding:1px 6px;margin-right:7px;letter-spacing:.03em;vertical-align:1px}
  .cpk.일정{color:var(--accent);border:1px solid rgba(124,108,240,.42)}
  .cpk.확인{color:var(--warn);border:1px solid rgba(224,163,60,.42)}

  footer{margin-top:38px;padding-top:16px;border-top:1px solid var(--line);
         font-size:11px;color:var(--ink3);line-height:1.7}
  footer a{color:var(--ink3)}
  .srclist{display:flex;flex-wrap:wrap;gap:5px;margin:8px 0 14px}
  .srclist a{font-size:11.5px;background:var(--surface2);border:1px solid var(--line);
             border-radius:16px;padding:3px 10px;color:var(--ink2);text-decoration:none}
  .srclist a:hover{color:var(--accent);border-color:var(--accent)}
  .mondaybox{background:var(--surface);border:1px solid var(--line);border-radius:12px;
             padding:18px;margin:10px 0 26px}
  .mondaybox h3{font-size:15px;margin:0 0 9px}.recap-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:17px}
  .recap-card{background:var(--surface2);border:1px solid var(--line);border-radius:9px;padding:11px 12px;line-height:1.5}
  .recap-no{display:block;color:var(--accent);font-size:11px;font-weight:800;letter-spacing:.06em;margin-bottom:5px}
  .weekend-label{display:inline-block;font-size:11px;font-weight:700;color:var(--accent);margin-bottom:5px}
  .weekend-item{padding:10px 0;border-top:1px solid var(--line)}
  .weekend-item p{margin:4px 0;line-height:1.55}.open-impact{margin-top:12px;padding:11px 13px;
             border-left:3px solid var(--accent);background:var(--surface2);line-height:1.6}
  @media(max-width:700px){.recap-grid{grid-template-columns:1fr}.recap-card{padding:10px 11px}}
</style>
</head>
<body>
<div class="wrap">

<header>
  <div class="eyebrow">Morning Brief · ETF Edition</div>
  <h1>{{ 날짜표시 }} {{ 제목 }}</h1>
  <p class="sub">{% if 브리핑역할 %}{{ 브리핑역할 }} · {% endif %}{{ 기준설명 }}</p>
  {% if 카카오JS키 and 공유주소 and 공유본문 %}
  <div class="sharebar"><button type="button" class="kakao-share" id="kakao-share-button"
    aria-label="이 브리핑을 카카오톡 채팅방에 공유">💬 카카오톡으로 공유</button></div>
  {% endif %}
</header>

{% if 월요일요약 %}
<h2>🧭 월요일 출발점 <span class="tag">지난주 복기 + 주말 변수</span></h2>
<div class="mondaybox">
  {% if 월요일요약.지난주복기 %}<h3>지난주 시장 3줄 복기</h3><div class="recap-grid">{% for x in 월요일요약.지난주복기 %}<div class="recap-card"><span class="recap-no">0{{ loop.index }}</span>{{ x }}</div>{% endfor %}</div>{% endif %}
  {% if 월요일요약.주말변수 %}<h3>금요일 장 마감 뒤 달라진 것</h3>
    {% for x in 월요일요약.주말변수 %}<div class="weekend-item"><span class="weekend-label">주말 변수</span><br><b>{{ x.제목 }}</b><p>{{ x.설명 }}</p>
    {% if x.출처 %}<div class="src">출처 · {% for s in x.출처 %}{% if s.url %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.이름 }}{% if s.날짜 %} ({{ s.날짜 }} 보도){% endif %}</a>{% else %}{{ s.이름 }}{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}</div>{% endfor %}
  {% endif %}
  {% if 월요일요약.국내개장영향 %}<div class="open-impact"><b>월요일 국내장·ETF 연결</b><br>{{ 월요일요약.국내개장영향 }}</div>{% endif %}
</div>
{% endif %}

{# ─────────── 1. TOP 5 ─────────── #}
{% if ai.top5 %}
<h2>🎯 {% if 모드 == 'weekly' %}이번 주를 움직인 5가지{% else %}오늘 아침 5줄 요약{% endif %}<span class="tip" tabindex="0">?<span class="bubble">
  가장 중요한 다섯 사건을 <b>무슨 일 / 왜 중요한지</b>까지 펼쳐 보여줍니다.</span></span>
  <span class="tag">30초 스캔</span></h2>
<div class="top5">
  {% for r in ai.top5 %}
  <div class="rank r{{ r.순위 }}">
    <div class="no">{{ r.순위 }}</div>
    <div>
      <p class="t">{{ r.제목 }}</p>
      <p class="n">{{ r.숫자 }}{% if r.영향 %}<span class="arrow">→</span><span class="eff">{{ r.영향|glossary }}</span>{% endif %}</p>
      {% if r.설명 %}<p class="desc">{{ r.설명|glossary }}</p>{% endif %}
      {% if r.출처 %}<div class="src">출처 · {% for s in r.출처 %}{% if s.url %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.이름 }}{% if s.날짜 %} ({{ s.날짜 }} 보도){% endif %}</a>{% else %}{{ s.이름 }}{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}

{# ─────────── 2. 시장 한눈에 ─────────── #}
{% if 한눈에 %}
<h2>📈 시장 한눈에 <span class="tag">{{ 기준일태그 }}</span></h2>
<div class="glance">
  {% for group in 한눈에 %}
  <div class="grow">
    <div class="glabel">{{ group.라벨 }}</div>
    {% for c in group.항목 %}
    <div class="gcell">
      <span class="k">{{ c.이름 }}</span>
      <span class="v">{{ c.값 }}<span class="p {{ c.방향 }}">{{ c.변화 }}</span></span>
    </div>
    {% endfor %}
  </div>
  {% endfor %}
</div>
{% endif %}

{% if 주간대표흐름 %}
<h2>🗓️ 대표 자산 기간별 흐름 <span class="tag">주간 비교</span></h2>
<table class="period"><thead><tr><th>대표 자산</th><th>1일</th><th>1주</th><th>1개월</th></tr></thead><tbody>
{% for r in 주간대표흐름 %}<tr><td>{{ r.이름 }}</td><td class="{{ r['1일방향'] }}">{{ r['1일'] }}</td><td class="{{ r['1주방향'] }}">{{ r['1주'] }}</td><td class="{{ r['1개월방향'] }}">{{ r['1개월'] }}</td></tr>{% endfor %}
</tbody></table>
{% endif %}

{% if ai.시장국면 %}
<div class="regime"><div class="marketbadge">변화 감지</div><h3>{{ ai.시장국면.제목 }}</h3><p>{{ ai.시장국면.설명 }}</p>
{% if ai.시장국면.출처 %}<div class="src">출처 · {% for s in ai.시장국면.출처 %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.이름 }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}</div>
{% endif %}

{% if ai.관망요인 %}
<div class="waitbox">
  <h3>⏸️ {{ ai.관망요인.제목 }} <span class="tag">{{ ai.관망요인.시장 }}</span></h3>
  {% for x in ai.관망요인.항목 %}
  <div class="waititem"><div class="wt"><span class="wn">{{ "%02d"|format(loop.index) }}</span><b>{{ x.제목 }}</b></div>
    <p class="path">{{ x.전달경로 }}</p>
    <details class="evidence"><summary>사실 근거 보기</summary><p>{{ x.설명 }}</p>
      {% if x.출처 %}<div class="src">출처 · {% for s in x.출처 %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.이름 }}{% if s.날짜 %} ({{ s.날짜 }} 보도){% endif %}</a>{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
    </details>
  </div>
  {% endfor %}
</div>
{% endif %}

{# ─────────── 3. 시장 스토리 ─────────── #}
{% if ai.시장브리핑 %}
<h2>🧭 {% if 모드 == 'weekly' %}이번 주 핵심 이야기{% else %}밤사이 핵심 이야기{% endif %}<span class="tip" tabindex="0">?<span class="bubble">
  숫자만 나열하지 않고 배경, 시장 반응, 한국 시장과 ETF로 이어지는 흐름을 설명합니다.</span></span>
  <span class="tag">배경부터 차근차근</span></h2>
{% for c in ai.시장브리핑 %}
<div class="story">
  <div class="storyhead"><span class="marketbadge">{{ c.시장 }}</span><h3>{{ c.제목 }}</h3></div>
  <p class="story-copy"><b>무슨 일이 있었나.</b> {{ c.결과|glossary }}</p>
  {% if c.원인 %}<p class="story-copy">{{ c.원인|glossary }}</p>{% endif %}
  {% if c.전달경로 %}<div class="story-flow">흐름 한눈에 · {{ c.전달경로|glossary }}</div>{% endif %}
  {% if c.ETF연결 %}<div class="story-takeaway"><b>그래서 오늘 볼 것</b><br>{{ c.ETF연결|glossary }}</div>{% endif %}
  {% if c.출처 %}<div class="src">출처 · {% for s in c.출처 %}{% if s.url %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.이름 }}{% if s.날짜 %} ({{ s.날짜 }} 보도){% endif %}</a>{% else %}{{ s.이름 }}{% if s.날짜 %} ({{ s.날짜 }} 보도){% endif %}{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
  {% if c.시장 == '국내' and ai.관심종목 %}
  <div class="stockwatch"><b>{% if 모드 == 'weekly' %}이번 주 특징주{% else %}오늘의 특징주{% endif %}</b>
    {% for s in ai.관심종목 %}<div class="sitem"><div class="st"><b>👀 {{ s.이름 }}</b>{% if s.등락률 is defined and s.등락률 is not none %}<span class="{{ 'up' if s.등락률 > 0 else 'down' }}">{{ "%+.2f"|format(s.등락률) }}%</span>{% endif %}</div><p>{{ s.이유 }}</p>{% if s.출처 %}<div class="src">출처 · {% for x in s.출처 %}{% if x.url %}<a href="{{ x.url }}" target="_blank" rel="noopener">{{ x.이름 }}{% if x.날짜 %} ({{ x.날짜 }} 보도){% endif %}</a>{% else %}{{ x.이름 }}{% if x.날짜 %} ({{ x.날짜 }} 보도){% endif %}{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}</div>{% endfor %}
  </div>
  {% endif %}
</div>
{% endfor %}
{% if ai.오늘관전 %}<div class="watch"><b>{% if 모드 == 'weekly' %}다음 주 관전 포인트{% else %}오늘 관전 포인트{% endif %}</b><ol>{% for x in ai.오늘관전 %}<li>{{ x }}</li>{% endfor %}</ol></div>{% endif %}
{% endif %}

{# ─────────── 놓치면 안 될 경제·세상 이슈 ─────────── #}
{% if ai.놓치면안될이슈 %}
<h2>🌍 놓치면 안 될 경제·세상 이슈<span class="tip" tabindex="0"><span class="bubble">
  당일 가격 반응이 작아도 정책·산업·기술·국제정세·생활경제에 오래 영향을 줄 수 있는 새 변화를 고릅니다.
  중요도에 따라 하루 3~5개를 보여줍니다.</span></span><span class="tag">선행 이슈 3~5개</span></h2>
<div class="worldissues">
  {% for x in ai.놓치면안될이슈 %}
  <article class="worlditem">
    <div class="worldhead"><span class="worldbadge">{{ x.분야 }}</span><h3>{{ x.제목 }}</h3></div>
    <p>{{ x.무슨일|glossary }}</p>
    <p class="worldpath"><b>왜 중요한가</b> · {{ x.왜중요|glossary }}</p>
    {% if x.확인할것 %}<div class="worldcheck"><b>다음 확인</b> · {{ x.확인할것 }}</div>{% endif %}
    {% if x.출처 %}<div class="src">출처 · {% for s in x.출처 %}{% if s.url %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.이름 }}{% if s.날짜 %} ({{ s.날짜 }} 보도){% endif %}</a>{% else %}{{ s.이름 }}{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
  </article>
  {% endfor %}
</div>
{% endif %}

{# ─────────── 4. ETF 레이더 ─────────── #}
{% if ai.etf_레이더 or ETF흐름판 %}
<h2>📡 ETF 레이더<span class="tip" tabindex="0">?<span class="bubble">
  수익률·거래 집중으로 실제 시장 반응을 먼저 보고, 관련 뉴스는 <b>핵심 3개와 추가 뉴스 최대 5개</b>로 나눕니다.
  해당 없는 갈래는 표시하지 않습니다.<br><br>
  ① 순매수·순매도 특이 수급 ② 최근 자금유입 급증 ③ 순자산 급증
  ④ 신규 상장 ⑤ 거래량 급증 ⑥ 운용사 주요 신상품·보도자료</span></span>
  <span class="tag">{% if ETF흐름판.기간 %}{{ ETF흐름판.기간 }}{% else %}전일{% endif %} 기준</span></h2>
{% if ETF흐름판 and (ETF흐름판.한국 or ETF흐름판.미국) %}
<div class="flowboard">
  <input class="flowtab-input" type="radio" name="flow-country" id="flow-kr" checked>
  <input class="flowtab-input" type="radio" name="flow-country" id="flow-us">
  <div class="flowtabs" role="tablist" aria-label="ETF 상장 국가 선택">
    <label for="flow-kr" role="tab">한국</label><label for="flow-us" role="tab">미국</label>
  </div>
  <div class="flow-panels">
  {% for country, board, cls in [('한국', ETF흐름판.한국, 'kr'), ('미국', ETF흐름판.미국, 'us')] %}
  <div class="flow-panel {{ cls }}">
    <div class="flow-head"><b>ETF 흐름판 · {{ country }} 상승·하락 TOP3</b><span>{% if board.기준일 %}{{ board.기준일 }} 확정 마감 · {% endif %}{{ board.필터설명 }}{% if board.출처 %} · {{ board.출처 }}{% endif %}</span></div>
    <div class="flow-grid">
      <div class="flow-col"><h3>상승률 TOP3</h3>
        {% for x in board.상승 %}<div class="flow-row"><span class="nm">{% if country == '미국' and x.티커 %}{{ x.티커 }} · {% endif %}{{ x.이름 }}</span><span class="pct up">{{ "%+.2f"|format(x.등락률) }}%</span></div>{% endfor %}
        {% if board.상승안내 %}<p class="flow-empty">{{ board.상승안내 }}</p>{% endif %}
      </div>
      <div class="flow-col"><h3>하락률 TOP3</h3>
        {% for x in board.하락 %}<div class="flow-row"><span class="nm">{% if country == '미국' and x.티커 %}{{ x.티커 }} · {% endif %}{{ x.이름 }}</span><span class="pct down">{{ "%+.2f"|format(x.등락률) }}%</span></div>{% endfor %}
        {% if board.하락안내 %}<p class="flow-empty">{{ board.하락안내 }}</p>{% endif %}
      </div>
    </div>
    {% if board.고변동상품 %}<div class="flow-extra"><b>레버리지·인버스 별도</b>{% for x in board.고변동상품 %}<span>{{ x.이름 }} {{ "%+.2f"|format(x.등락률) }}%</span>{% endfor %}</div>{% endif %}
    {% if board.거래집중 %}<div class="flow-extra"><b>거래량 급증</b>{% for x in board.거래집중 %}<span>{{ x.이름 }} {{ x.배수 }}배</span>{% endfor %}</div>{% endif %}
  </div>
  {% endfor %}
  </div>
</div>
{% endif %}
{% if ai.주도테마 %}
<div class="themebox">
  <div class="themehead"><span class="badge">오늘의 주도 테마 · {{ ai.주도테마.테마 }}</span><h3>{{ ai.주도테마.제목 }}</h3></div>
  {% if ai.주도테마.움직임 %}<div class="themerow"><span class="k">움직임</span><span class="v">{{ ai.주도테마.움직임 }}</span></div>{% endif %}
  <div class="themerow"><span class="k">왜?</span><span class="v">{{ ai.주도테마.원인 }}</span></div>
  {% if ai.주도테마.주도종목 %}<div class="leaders">{% for s in ai.주도테마.주도종목 %}<span class="leader">{{ s.이름 }}{% if s.등락률 is defined and s.등락률 is not none %}<b class="{{ 'up' if s.등락률 > 0 else 'down' }}">{{ "%+.2f"|format(s.등락률) }}%</b>{% endif %}</span>{% endfor %}</div>{% endif %}
  {% if ai.주도테마.ETF연결 %}<div class="themerow"><span class="k">볼 것</span><span class="v">{{ ai.주도테마.ETF연결 }}</span></div>{% endif %}
  {% if ai.주도테마.출처 %}<div class="src">출처 · {% for s in ai.주도테마.출처 %}{% if s.url %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.이름 }}{% if s.날짜 %} ({{ s.날짜 }} 보도){% endif %}</a>{% else %}{{ s.이름 }}{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
</div>
{% endif %}
{% if ai.etf_레이더 %}
<div class="radar">
  {% for r in ai.etf_레이더[:3] %}
  <div class="ritem">
    <div class="h"><span class="badge">{{ r.구분 }}</span><span class="t">{{ r.제목 }}</span></div>
    <p>{{ r.사실 }}</p>
    {% if r.출처 %}
    <div class="src">출처 ·
      {% for s in r.출처 %}{% if s.url %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.이름 }}{% if s.날짜 %} ({{ s.날짜 }} 보도){% endif %}</a>{% else %}{{ s.이름 }}{% if s.날짜 %} ({{ s.날짜 }} 보도){% endif %}{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}
</div>
{% if ai.etf_레이더|length > 3 %}
<details class="more-news">
  <summary>추가로 읽을 ETF 뉴스 {{ ai.etf_레이더|length - 3 }}개</summary>
  {% for r in ai.etf_레이더[3:] %}
  <div class="more-item">
    <span class="badge">{{ r.구분 }}</span>
    {% set linked = r.출처|selectattr('url')|list if r.출처 else [] %}
    {% if linked %}<a href="{{ linked[0].url }}" target="_blank" rel="noopener">{{ r.제목 }}</a>{% else %}<span>{{ r.제목 }}</span>{% endif %}
    {% if r.출처 %}<small>{{ r.출처|map(attribute='이름')|join(' · ') }}</small>{% endif %}
  </div>
  {% endfor %}
</details>
{% endif %}
{% endif %}
{% endif %}

{# ─────────── 전일 ETF 뉴스 헤드라인 ─────────── #}
{% if 전일ETF뉴스 %}
<h2>🗞️ 전일 ETF 뉴스 헤드라인<span class="tip" tabindex="0">?<span class="bubble">
  전 거래일에 발행된 ETF·자산운용 관련 기사입니다. 주요 뉴스와 ETF 레이더에 뽑히지 않은 기사도
  제목을 훑어볼 수 있도록 원문 링크 그대로 최대 6건을 보여줍니다.</span></span>
  <span class="tag">{{ 기준일태그 }}</span></h2>
<div class="newslist">
  {% for n in 전일ETF뉴스 %}
  <div class="nitem">
    <div class="nno">{{ loop.index }}</div>
    <div>
      <a href="{{ n.링크 }}" target="_blank" rel="noopener">{{ n.제목 }}</a>
      <div class="nmeta">{{ n.출처 }}{% if n.날짜 %} · {{ n.날짜 }}{% endif %}</div>
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}

{# ─────────── 5. 경쟁 유튜브 ─────────── #}
{% if 유튜브영상 or 유튜브운용사 %}
<h2>📺 경쟁 채널 동향<span class="tip" tabindex="0">?<span class="bubble">
  설정 파일에 등록된 채널의 최근 업로드 중 최대 5개. 당일 처음 잡힌 영상은 재실행해도 유지합니다.
  <b>ETF를 다룬 영상을 먼저 고릅니다.</b><br>
  <b>채널 관련성</b>은 영상이 ETF 아는형의 상시 콘텐츠 범위와 얼마나 가까운지를 뜻합니다.
  <b>높음</b>=ETF·ISA·연금·지수투자 등 채널 핵심 주제,
  <b>보통</b>=금리·종목·시장 전망 등 인접 주제,
  <b>낮음</b>=재테크 일반 또는 채널과 직접 연결이 적은 주제입니다.</span></span>
  <span class="tag">최근 이틀</span></h2>
<div class="yt">
  {% for v in 유튜브영상 %}
  <div class="ytc">
    <div class="top">
      <a href="{{ v.링크 }}" target="_blank" rel="noopener">{{ v.제목 }}</a>
      {% if v.관련성 %}<span class="ov {{ v.관련성등급 }}">채널 관련성 {{ v.관련성 }}</span>{% endif %}
    </div>
    <div class="meta">{{ v.채널 }} · 조회 {{ v.조회수표시 }} · 업로드 {{ v.경과 }}
      · {{ v.채널유형 }}
      {% if v.관련성근거 %} · {{ v.관련성근거 }}{% endif %}</div>
    <div class="row">
      {% if v.핵심주제 %}<div class="k">핵심 주제</div><div class="v">{{ v.핵심주제 }}</div>{% endif %}
      {% if v.훅 %}<div class="k">제목 훅</div><div class="v">{{ v.훅 }}</div>{% endif %}
    </div>
  </div>
  {% endfor %}
</div>
{% if 유튜브운용사 %}
<div class="notice"><b>운용사 마케팅 동향</b> · {% for v in 유튜브운용사 %}<a href="{{ v.링크 }}" target="_blank" rel="noopener">{{ v.채널 }} — {{ v.제목 }}</a>{% endfor %}</div>
{% endif %}
{% if 유튜브각주 %}<div class="notice">{{ 유튜브각주 }}</div>{% endif %}
{% if ai.댓글키워드 %}
<div class="card">
  <p class="fact"><span class="k">시청자 질문</span>{{ ai.댓글키워드 }}</p>
</div>
{% endif %}
{% endif %}

{# ─────────── 6. 콘텐츠 후보 ─────────── #}
{% if ai.콘텐츠후보 %}
<h2>🎬 ETF 아는형 콘텐츠 후보<span class="tip" tabindex="0">?<span class="bubble">
  <b>아직 만들지 않은 기획안입니다.</b> 오늘 데이터를 근거로 AI가 제안한
  영상 제목·질문 초안이며, 실제로 존재하는 영상이 아닙니다.
  (이미 올라온 다른 채널 영상은 '경쟁 채널 동향'에 따로 나옵니다.)</span></span>
  <span class="tag">기획안 · 최대 2개</span></h2>
{% for i in ai.콘텐츠후보 %}
<div class="idea">
  <div class="k">{{ i.코너 }} · 제목안</div>
  <h3>{{ i.제목 }}</h3>
  <div class="row">
    <div class="k2">이유</div><div class="v">{{ i.이유 }}</div>
    <div class="k2">관련 ETF</div><div class="v">{{ i.관련ETF }}</div>
    {% if i.차별점 %}<div class="k2">차별화 각도</div><div class="v">{{ i.차별점 }}</div>{% endif %}
  </div>
  {% if i.질문 %}<div class="q"><b>출연자 질문</b> — “{{ i.질문 }}”</div>{% endif %}
</div>
{% endfor %}
{% endif %}

{# ─────────── 8. 일정 ─────────── #}
{% if 체크포인트그룹 %}
<h2>🗓️ 체크포인트 · 주요 일정<span class="tip" tabindex="0">?<span class="bubble">
  두 가지를 함께 담습니다.<br>
  <b>일정</b> — 날짜가 확정된 것 (FOMC, 금통위, 실적 발표, ETF 상장일)<br>
  <b>확인</b> — 날짜는 없지만 계속 지켜봐야 하는 것 (수급 연속 여부, 특정 레벨 유지 여부)</span></span></h2>
<div class="cal">
  {% for group in 체크포인트그룹 %}
  <div class="calgroup">{{ group.라벨 }}</div>
  {% for e in group.항목 %}
  <div class="d"><span class="cpk {{ '일정' if e.유형 == '일정' else '확인' }}">{{ e.유형 }}</span>{{ e.표시때 }}</div>
  <div class="e">{{ e.내용 }}{% if e.출처 and e.출처.url %}<small><a href="{{ e.출처.url }}" target="_blank" rel="noopener">{{ e.출처.이름 }}</a></small>{% endif %}</div>
  {% endfor %}
  {% endfor %}
</div>
{% endif %}

{# ─────────── 9. 출처 ─────────── #}
<h2>🔗 출처</h2>
<div class="srclist">
  {% for s in 출처목록 %}
  {% if s.url %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.이름 }}{% if s.날짜 %} ({{ s.날짜 }}){% endif %}</a>{% else %}<a>{{ s.이름 }}</a>{% endif %}
  {% endfor %}
</div>

<footer>
  생성 {{ 생성시각 }} · 자동 브리핑{% if 모드 == 'daily' %} · 주 단위 지표는 토요일 브리핑에 담깁니다{% endif %}<br>
  ※ 국내 투자자 해외주식 수급은 한국예탁결제원 결제 기준으로 실제 매매일보다 2~3영업일 지연됩니다.<br>
  ※ 정보 제공 목적이며 투자 권유가 아닙니다. '해석'은 확정된 사실이 아닙니다. 투자 판단과 결과는 본인 책임입니다.
</footer>

</div>
{% if 카카오JS키 and 공유주소 and 공유본문 %}
<script src="https://t1.kakaocdn.net/kakao_js_sdk/2.7.4/kakao.min.js"></script>
<script>
(() => {
  const button = document.getElementById('kakao-share-button');
  if (!button) return;
  const jsKey = {{ 카카오JS키|tojson }};
  const shareUrl = {{ 공유주소|tojson }};
  const shareText = {{ 공유본문|tojson }};

  button.addEventListener('click', () => {
    if (!window.Kakao) {
      window.alert('카카오톡 공유 기능을 불러오지 못했습니다. 잠시 후 다시 시도해주세요.');
      return;
    }
    if (!Kakao.isInitialized()) Kakao.init(jsKey);
    Kakao.Share.sendDefault({
      objectType: 'text',
      text: shareText,
      link: {mobileWebUrl: shareUrl, webUrl: shareUrl},
      buttonTitle: '전문 보기'
    });
  });
})();
</script>
{% endif %}
</body>
</html>
